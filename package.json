{
  "name": "@impermeable/waterproof-editor",
  "version": "0.19.0",
  "description": "Waterproof Editor ",
  "homepage": "https://github.com/impermeable/waterproof-editor#readme",
  "bugs": {
    "url": "https://github.com/impermeable/waterproof-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impermeable/waterproof-editor.git"
  },
  "license": "MIT",
  "author": "impermeable",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css",
    "./waterproof-defaults.css": "./dist/styles/waterproof-defaults.css"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:esbuild-debug": "node esbuild.mjs --watch --debug",
    "watch:tsc": "npx tsc -b --watch",
    "test": "npm run unit-tests",
    "unit-tests": "npx jest",
    "unit-tests-cov": "npx jest --coverage --collectCoverageFrom=src/**/*.ts",
    "typecheck": "npx tsc -b",
    "build": "npm run typecheck && node esbuild.mjs --minify",
    "lint": "npx eslint .",
    "lint-fix": "npx eslint . --fix",
    "format": "npx prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "format:check": "npx prettier --check \"**/*.{ts,tsx,js,mjs}\""
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@types/glob": "8.1.0",
    "@types/jest": "^30.0.0",
    "@types/jquery": "4.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "26.6.5",
    "esbuild": "^0.28.1",
    "eslint": "10.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "prosemirror-dev-tools": "^4.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@benrbray/prosemirror-math": "1.0.0",
    "@types/katex": "^0.16.8",
    "jquery": "4.0.0",
    "katex": "^0.19.0",
    "markdown-it": "15.0.3",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.8"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.0.5",
      "diff": "8.0.3"
    },
    "katex": "^0.19.0",
    "sprintf-js": "^1.1.3",
    "js-yaml": "5.4.3",
    "brace-expansion": "5.0.12"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  }
}
