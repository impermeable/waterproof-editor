{
  "name": "@impermeable/waterproof-editor",
  "version": "0.15.1",
  "description": "Waterproof Editor ",
  "homepage": "https://github.com/impermeable/waterproof-editor#readme",
  "bugs": {
    "url": "https://github.com/impermeable/waterproof-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impermeable/waterproof-editor.git"
  },
  "license": "MIT",
  "author": "impermeable",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css",
    "./waterproof-defaults.css": "./dist/styles/waterproof-defaults.css"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:esbuild-debug": "node esbuild.mjs --watch --debug",
    "watch:tsc": "npx tsc -b --watch",
    "test": "npm run unit-tests",
    "unit-tests": "npx jest",
    "unit-tests-cov": "npx jest --coverage --collectCoverageFrom=src/**/*.ts",
    "typecheck": "npx tsc -b",
    "build": "npm run typecheck && node esbuild.mjs --minify",
    "lint": "npx eslint .",
    "lint-fix": "npx eslint . --fix",
    "format": "npx prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "format:check": "npx prettier --check \"**/*.{ts,tsx,js,mjs}\""
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.18.1",
    "@codemirror/commands": "6.6.2",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "6.9.2",
    "@codemirror/state": "~6.5.3",
    "@codemirror/view": "6.38.8",
    "@eslint/js": "^9.18.0",
    "@types/glob": "^7.1.1",
    "@types/jest": "^29.5.1",
    "@types/jquery": "^3.5.16",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.11.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "prosemirror-dev-tools": "^4.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@benrbray/prosemirror-math": "1.0.0",
    "@lezer/highlight": "1.2.1",
    "@lezer/lr": "1.4.2",
    "jquery": "3.7.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.1",
    "prosemirror-commands": "1.6.0",
    "prosemirror-history": "1.4.1",
    "prosemirror-inputrules": "1.4.0",
    "prosemirror-keymap": "1.2.2",
    "prosemirror-markdown": "1.13.1",
    "prosemirror-model": "1.22.3",
    "prosemirror-state": "1.4.3",
    "prosemirror-transform": "1.10.0",
    "prosemirror-view": "1.34.3"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.0.5",
      "diff": "8.0.3"
    },
    "eslint": {
      "brace-expansion": "2.1.0"
    },
    "js-yaml": "4.2.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "6.18.1",
    "@codemirror/commands": "6.6.2",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "6.9.2",
    "@codemirror/state": "~6.5.2",
    "@codemirror/view": "6.38.8"
  }
}
