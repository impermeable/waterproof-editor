{
	"&": {
	  "color": "var(--wp-foreground)",
	  "backgroundColor": "transparent"
	},
  
	".cm-content": {
	  "caretColor": "auto",
	  "fontFamily": "var(--wp-fontFamily)",
	  "fontSize": "var(--wp-editorFontSize)",
	  "fontWeight": "var(--wp-editorFontWeight)"
	},
  
	".cm-cursor, .cm-dropCursor": {"borderLeftColor": "auto"},
	
	".cm-panels": {"backgroundColor": "var(--wp-listDropBackground)", "color": "var(--wp-listHighlightForeground)"},
	".cm-panels.cm-panels-top": {"borderBottom": "2px solid black"},
	".cm-panels.cm-panels-bottom": {"borderTop": "2px solid black"},
  
	".cm-searchMatch": {
	  "backgroundColor": "#72a1ff59",
	  "outline": "1px solid #457dff"
	},
	".cm-searchMatch.cm-searchMatch-selected": {
	  "backgroundColor": "#6199ff2f"
	},
  
	".cm-activeLine": {"backgroundColor": "#6699ff0b"},
	".cm-selectionMatch": {"backgroundColor": "#aafe661a"},
  
	".cm-tooltip": {
	  "border": "none",
	  "color": "var(--wp-menuForeground)",
	  "backgroundColor": "var(--wp-menuBackground)"
	},
	".cm-tooltip .cm-tooltip-arrow:before": {
	  "borderTopColor": "transparent",
	  "borderBottomColor": "transparent"
	},
	".cm-tooltip .cm-tooltip-arrow:after": {
	  "borderTopColor": "var(--wp-menuSeparatorBackground)",
	  "borderBottomColor": "var(--wp-menuSeparatorBackground)"
	},
	".cm-tooltip-autocomplete": {
	  "& > ul > li[aria-selected]": {
		"backgroundColor": "var(--wp-menuSelectionBackground)",
		"color": "var(--wp-menuSelectionForeground)"
	  }
	},
    ".cm-completionIcon": {
        "fontSize": "100%",
        "width": "1.5em",
        "opacity": "1.0"
    }
}