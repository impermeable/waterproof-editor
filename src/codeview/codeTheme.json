{
	"&": {
	  "color": "var(--wp-inputForeground)",
	  "backgroundColor": "var(--wp-listFilterWidgetBackground)"
	},

    ".cm-diagnostic": {
      "display": "grid",
      "gridTemplateColumns": "max-content 1fr",
      "gridTemplateRows": "1fr repeat(20, max-content) 1fr",
      "columnGap": "8px",
      "padding": "4px 0"
    },

    ".cm-diagnostic::before": {
      "content": "\"\"",
      "gridColumn": "1",
      "gridRow": "1"
    },

    ".cm-diagnostic::after": {
      "content": "\"\"",
      "gridColumn": "1",
      "gridRow": "-1"
    },

    ".cm-diagnosticText": {
      "gridColumn": "2",
      "gridRow": "1 / -1",
      "minWidth": "150px",
      "maxHeight": "12em",
      "overflowY": "auto",
      "paddingRight": "4px"
    },

    ".cm-diagnosticAction": {
      "gridColumn": "1",
      "alignSelf": "center",
      "marginBottom": "4px"
    },

    ".cm-diagnosticAction:last-of-type": {
      "marginBottom": "0"
    },

	".cm-content": {
	  "caretColor": "auto",
	  "fontFamily": "var(--wp-editorFontFamily)",
	  "fontSize": "var(--wp-editorFontSize)",
	  "fontWeight": "var(--wp-editorFontWeight)"
	},
  	".cm-cursor, .cm-dropCursor": {"borderLeftColor": "auto"},

	".cm-panels": {"color": "var(--wp-listHighlightForeground)"},
	".cm-panel-lint": {"backgroundColor": "var(--wp-listFilterWidgetBackground)", "color": "var(--wp-listHighlightForeground)"},
	".cm-panel-lint > ul": {
		"color": "var(--wp-listHighlightForeground)",
		"display": "flex", 
		"flexFlow": "column"
	},
	".cm-panel.cm-panel-lint ul": {
		"maxHeight": "25vh"
	},
	".cm-panel.cm-panel-lint ul [aria-selected]": {
		"background-color": "var(--wp-listActiveselectionBackground)",
		"color": "var(--wp-listActiveselectionForeground)"
	},

	".cm-activeLine": {"backgroundColor": "var(--wp-editorLineHighlightBackground)"},
    "&:not(.cm-focused) .cm-activeLine": { "backgroundColor": "transparent"},
	".cm-selectionMatch": {"backgroundColor": "#aafe661a"},
	"&.cm-focused .cm-matchingBracket, &.cm-focused .cm-nonmatchingBracket": {
	  "backgroundColor": "#bad0f847"
	},
  
	".cm-gutters": {
	  "backgroundColor": "var(--wp-listFilterWidgetBackground)",
	  "color": "var(--wp-editorInlayHintForeground)",
	  "border": "none"
	},

	".cm-gutters-after": {
	  "backgroundColor": "var(--wp-editorInlayHintBackground)"
	},

	".cm-status-spacer": {
	  "width": "var(--wp-status-indicator-width)",
	  "minWidth": "var(--wp-status-indicator-width)"
	},

	".cm-lineNumbers .cm-gutterElement": {
	  "textAlign": "left"
	},

	".cm-gutter-lint": {
	  "width": "1.2em",
	  "minWidth": "1.2em",
	  "& .cm-gutterElement": {
	    "padding": "0.2em 0.1em"
	  }
	},

	".cm-activeLineGutter": {
	  "backgroundColor": "var(--wp-editorLightBulbForeground)"
	},
  
	".cm-foldPlaceholder": {
	  "backgroundColor": "transparent",
	  "border": "none",
	  "color": "#ddd"
	},
  
	".cm-tooltip": {
	  "border": "none",
	  "color": "var(--wp-menuForeground)",
	  "backgroundColor": "var(--wp-menuBackground)"
	},
	".cm-tooltip-lint": {
		"display": "flex",
		"flexFlow": "column"
	},
	".cm-lintRange-active": {
		"backgroundColor": "transparent"
	},
	".cm-tooltip .cm-tooltip-arrow:before": {
	  "borderTopColor": "transparent",
	  "borderBottomColor": "transparent"
	},
	".cm-tooltip .cm-tooltip-arrow:after": {
	  "borderTopColor": "var(--wp-menuSeparatorBackground)",
	  "borderBottomColor": "var(--wp-menuSeparatorBackground)"
	},
	".cm-tooltip-autocomplete": {
	  "& > ul > li[aria-selected]": {
		"backgroundColor": "var(--wp-menuSelectionBackground)",
		"color": "var(--wp-menuSelectionForeground)"
	  }
	},
    ".cm-completionIcon": {
        "fontSize": "100%",
        "width": "1.5em",
        "opacity": "1.0"
    }
}