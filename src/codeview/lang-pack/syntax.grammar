@top Program { Sentence* }
// @external tokens TakeInput from "./externalTokens" { TakeInput }

// @tokens {
//    space { @whitespace }
//    TacticEnd { "." space+ | "." @eof }
//}

Sentence {
    ( TacticBullet* complement* WaterproofTactic | LemmaVernac | Statement)
    SentenceEnd
}

@local tokens {
    Space { @whitespace }
    TacticBullet{ "+" | "*" | "-" }
    SentenceEnd[@name='p'] { "." Space+ | "." @eof }
    // Tokens for WaterproofTactic
    WeArgueByContradiction { "We" Space+ "argue" Space+ "by" Space+ "contradiction" }
    Contradiction { "Contradiction" }
    WeShowBothStatements { "We" Space+ "show" Space+ "both" Space+ "statements" }
    WeShowBothDirections { "We" Space+ "show" Space+ "both" Space+ "directions" }
    WeNowShowTheInductionStep { "We" Space+ "now" Space+ "show" Space+ "the" Space+ "induction" Space+ "step" }
    WeConclude {"We" Space+ "conclude" Space+ "that" }
    Obtain {"Obtain"}
    AccordingTo {"according" Space+ "to" }
    SuchA {"such" (Space+ "a" "n"?)?}
    Take { "Take" }
    WeNeedToShowThat { "We" Space+ "need" Space+ "to" Space+ "show" Space+ "that" }
    Case { "Case" }
    AssumeThat { "Assume" Space+ "that" }
    ObtainSuchA { "Obtain" Space+ "such" Space+ "a" }
    ParenAmp { "(& " }
    ItSufficesToShowThat { "It" Space+ "suffices" Space+ "to" Space+ "show" Space+ "that" }
    ItHoldsThat { "It" Space+ "holds" Space+ "that" }
    WeClaimThat { "We" Space+ "claim" Space+ "that" }
    WeUseInductionOn { "We" Space+ "use" Space+ "induction" Space+ "on" }
    Indeed { "Indeed," }
    Use { "Use" }
    Choose { "Choose" }
    WeFirstShowTheBaseCase { "We" Space+ "first" Space+ "show" Space+ "the" Space+ "base" Space+ "case" }
    Expand { "Expand"}
    TacticMiddleByOrSince{"it" Space+ "suffices" Space+ "to" Space+ "show" Space+ "that" | "we" Space+ "conclude" Space+ "that" | "it" Space+ "holds" Space+ "that" }
    By { "By" }
    Define { "Define" }
    Since { "Since" }
    Because { "Because" }
    Either { "Either" }
    Proof { "Proof"}
    Qed { "Qed" }
    WeNeedToVerifyThat { "We" Space+ "need" Space+ "to" Space+ "verify" Space+ "that" }
    ByMagicItHoldsThat { "By" Space+ "magic" Space+ "it" Space+ "holds" Space+ "that" }
    ByMagicWeConcludeThat { "By" Space+ "magic" Space+ "we" Space+ "conclude" Space+ "that" }
    ByMagicItSufficesToShowThat { "By" Space+ "magic" Space+ "it" Space+ "suffices" Space+ "to" Space+ "show" Space+ "that" }
    // Tokens for LemmaVernac
    Lemma {"Lemma"}
    // Tokens for Statement
    RequireImport { "Require" Space+ "Import" }
    SetDefault { "Set" Space+ "Default" }
    OpenScope { "Open" Space+ "Scope" }
    Waterproof { "Waterproof" }
    Notation { "Notation" }
    Section { "Section" }
    Variable { "Variable" }
    Parameter { "Parameter" }
    TacticMiddleDefine{":="}
    TacticMiddleObtain{"according" Space+ "to"}
    TacticLabelAs{"as"}
    TacticMiddleBecauseFirst{"both"}
    TacticMiddleBecauseSecond{"and"}
    TacticMiddleEither{"or"}
    @else complement[@name='c']
    @precedence{ ByMagicItHoldsThat, ByMagicItSufficesToShowThat,
    ByMagicWeConcludeThat, By}
    @precedence{ ObtainSuchA, Obtain }
    @precedence{ Expand, TacticMiddleBecauseSecond}
}

// Skip WaterproofTactics
@skip {  } {
    WaterproofTactic {
        // Zero Input Tactics
        WeArgueByContradiction |
        Contradiction |
        WeShowBothStatements |
        WeShowBothDirections |
        WeNowShowTheInductionStep |
        // Single Input Tactics
        Take complement+ |
        WeNeedToShowThat complement+ |
        WeConclude complement+ |
        Case complement+ |
        AssumeThat complement+ (TacticLabelAs complement+)?|
        ObtainSuchA complement+ |
        ParenAmp complement+ |
        ItSufficesToShowThat complement+ |
        ItHoldsThat complement+ |
        WeClaimThat complement+ |
        WeUseInductionOn complement+ |
        Indeed complement+ |
        Use complement+ |
        Expand complement+ |
        Choose complement+ TacticMiddleDefine complement+ |
        WeFirstShowTheBaseCase complement+ |
        // Multi Input Tactics
        Obtain complement+ TacticMiddleObtain complement+ |
        By complement+ TacticMiddleByOrSince complement+ (TacticLabelAs complement+)? |
        Define complement+ TacticMiddleDefine complement+ |
        Since complement+ TacticMiddleByOrSince complement+ |
        Because complement+ TacticMiddleBecauseFirst complement+ (TacticLabelAs complement+)? TacticMiddleBecauseSecond complement+ (TacticLabelAs complement+)? |
        Either complement+ TacticMiddleEither complement+ |
        WeNeedToVerifyThat complement+ |
        ByMagicItHoldsThat complement+ (TacticLabelAs complement+)? |
        ByMagicWeConcludeThat complement+ (TacticLabelAs complement+)? |
        ByMagicItSufficesToShowThat complement+ (TacticLabelAs complement+)?
    }
    LemmaVernac {
        Lemma complement+ |
        Proof complement* |
        Qed complement*
    }
    Statement {
        RequireImport complement+ |
        Waterproof complement+  |
        SetDefault complement+  |
        OpenScope complement+  |
        Notation complement+  |
        Section complement+  |
        Variable complement+ |
        Parameter complement+
    }
}

// Other tokens
@tokens {

    Comment { "(*" ![*]* "*)" }

    ProofandQed {"Proof" | "Qed"}
}

@detectDelim
